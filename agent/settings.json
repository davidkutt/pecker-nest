{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "router",
  "defaultModel": "escalate",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "router/escalate",
    "openrouter/deepseek/deepseek-v4.1-flash-1017",
    "openrouter/z-ai/glm-5.3"
  ],
  "showCacheMissNotices": true,
  "defaultTools": ["+grep", "+find", "+ls"],
  "compaction": {
    "modelOverrides": {
      "router/escalate": { "reserveTokens": 800000 },
      "openrouter/deepseek/deepseek-v4.1-flash-1017": { "reserveTokens": 800000 },
      "openrouter/z-ai/glm-5.3": { "reserveTokens": 800000 }
    }
  },
  "packages": [
    "~/dev/pecker-nest",
    "npm:pi-subagents@0.87.0"
  ],
  "subagents": {
    "defaultModel": "openrouter/deepseek/deepseek-v4.1-flash-1017",
    "defaultSubagentOnlyExtensions": [
      "~/dev/pecker-nest/extensions/safety-gate.ts"
    ],
    "agentOverrides": {
      "oracle": { "model": "openrouter/z-ai/glm-5.3" },
      "researcher": { "disabled": true },
      "evidence-auditor": { "disabled": true },
      "claude-code": { "disabled": true },
      "claude-code-writer": { "disabled": true },
      "codex-exec": { "disabled": true },
      "codex-exec-writer": { "disabled": true },
      "cursor-agent": { "disabled": true },
      "cursor-agent-writer": { "disabled": true }
    }
  }
}
